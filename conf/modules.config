process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'FASTP' {
        ext.args = '--overrepresentation_analysis --overrepresentation_sampling 10 --low_complexity_filter --correction --dedup'
    }

    withName: 'BLAST_MAKEBLASTDB' {
        ext.args = '-dbtype nucl'
    }

    withName: 'BLAST_BLASTNPROBE2REF' {
        ext.args = '-task dc-megablast -outfmt 6 -evalue 1e-12 -qcov_hsp_perc 50'
        ext.prefix = {"${meta.id}.probe2reference"}
    }

    withName: 'BLAST_BLASTNPROBE2SCAFFOLD' {
        ext.args = '-task dc-megablast -outfmt "6 std qframe" -evalue 1e-12 -qcov_hsp_perc 50'
        ext.prefix = {"${meta.id}.probe2scaffold"}
    }

    withName: 'BLAST_BLASTNSCAFFOLD2REF' {
        ext.args = '-task dc-megablast -outfmt 6 -evalue 1e-12'
        ext.prefix = {"${meta.id}.scaffold2reference"}
    }

    withName: 'PARALOGFILTER' {
        ext.args = '-k12,12nr'
        ext.prefix = {"${meta.id}.probes_filtered"}
    }

    withName: 'SPADES' {
        scratch = true
        ext.args = '--careful'
        // ext.args = '--meta'
        // errorStrategy = { task.exitStatus == 2 ? 'ignore' : 'finish' }
        // publishDir = {"${params.outdir}/spades"}
    }

    withName: 'VSEARCH_CLUSTER' {
        cpus = 16
        memory = { 36.GB * task.attempt }
        time = { 8.h * task.attempt }
        ext.args = '--id 0.98 --query_cov 0.98 --strand both'
        ext.args2 = '--cluster_fast'
        ext.args3 = '--centroids'
    }

    withName: 'BLAST_MAKEBLASTDB2' {
        ext.args = '-dbtype nucl'
    }

    withName: 'BITSCOREFILTER' {
        ext.prefix = {"${meta.id}.filtered"}
    }

    withName: 'BEDTOOLS_GETFASTA' {
        ext.args = '-name'
    }

    withName: 'GNU_SORT2' {
        ext.args = '-k12,12nr'
        ext.args2 = '-t ":" -u -k1,1'
        ext.prefix = {"${meta.id}.ortho_filtered"}
    }

    withName: 'GETORTHOLOGS_PROBE' {
        ext.args = '-name'
        ext.prefix = {"${meta.id}.probe_ortho"}
    }

    withName: 'GETORTHOLOGS_FULL' {
        ext.args = '-name'
        ext.prefix = {"${meta.id}.full_ortho"}
    }


}

